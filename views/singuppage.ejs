<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>sing-up for automate your home</title>
    <link rel="stylesheet" href="cssfiles/singup.css">
</head>

<body>
    <div class="heding">
        <h1>welcome aboard! we're glad you're here - let's get started </h1>
    </div>
    <div class="contanair">
        <div class="box">
            <!-- for name -->
            <div class="form-group">
                <div class="wrapper">
                <label for="name">Full Name</label>
                </div>
                <div class="wrinput">
                    <input type="text" id="name" name="name" required>
                </div>
            </div>
            <!-- for email -->
            <div class="form-group">
                <div class="wrapper">
                    <label for="email">Email</label>
                </div>
                <div class="wrinput">
                    <input type="email" id="email" name="email" required>
                </div>
            </div>
            <!-- for password -->
            <div class="form-group">
                <div class="wrapper">
                    <label for="password">Password</label>
                </div>
                <div class="wrinput">
                    <input type="password" id="password" name="password" required>
                </div>
            </div>
            <!-- button for restart and submit -->
            <div class="buttongruop">
                <button class="re" type="reset">Reset</button>
                <button class="sub" type="submit">Submit</button>
            </div>
        </div>
    </div>
    <script src="/javascriptfiles/singup.js"></script>
</body>

</html>