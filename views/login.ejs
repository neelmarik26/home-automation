<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Futuristic Login</title>
    <link rel="stylesheet" href="/cssfiles/login.css">
</head>

<body>
    <div class="container">
        <div class="messagebox">
            <div id="mxbox">hello user</div>
        </div>
        <div class="login-box">
            <h2>Login</h2>
            <form>
                <div class="input-box">
                    <input type="text" id="emailinput" required>
                    <label>E-mail</label>
                </div>
                <div class="input-box">
                    <input type="password" id="passwordinput" required>
                    <label>Password</label>
                    <button type="button" id="togglePassword"><img src="assits/openey.svg" alt="Toggle password" id="eyeicon"></button>
                </div>
                <div class="remember-forgot">
                    <!-- <label><input id="remember" type="checkbox"> Remember me</label> -->
                    <a onclick="forgotPassword()">Forgot Password?</a>
                </div>
                <button type="submit" class="btn" id ='login'>Login</button>
                <div class="register-link">
                    Don't have an account? <button id="singupbtn">sing-up</button>
                </div>
            </form>
        </div>
    </div>
  

<!-- forget pass window -->
<div class="popup-overlay" id="forgotPasswordPopup">
    <div class="popup">
        <div class="popup-header">
            <h2>Reset Your Password</h2>
            <button class="close-btn" id="closePopup" onclick="closepopup()">&times;</button>
        </div>
        <div class="popup-body">
            <!-- Email Section -->
            <div id="emailSection">
                <div class="form-group">
                    <label for="email">Email Address</label>
                    <input type="email" id="forgetemail" placeholder="Enter your email address" required>
                </div>
                <p style="font-size: 14px; color: #666; margin-bottom: 20px;">
                    We'll send a One-Time Password (OTP) to your email to verify your identity. pls enter full otp for
                    submit button.
                </p>
                <div id="error" class="error-message"></div>
            </div>

            <!-- OTP Section -->
            <div class="otp-section" id="otpSection" style="display: none;">
                <div class="form-group">
                    <label for="otp">Enter OTP</label>
                    <div class="otp-inputs">
                        <input type="text" maxlength="1" class="otp-digit">
                        <input type="text" maxlength="1" class="otp-digit">
                        <input type="text" maxlength="1" class="otp-digit">
                        <input type="text" maxlength="1" class="otp-digit">
                        <input type="text" maxlength="1" class="otp-digit">
                        <input type="text" maxlength="1" class="otp-digit">
                    </div>
                </div>
                <div class="resend-otp">
                    <a href="#" id="resendOtp" onclick="restartfullsection()">Resend OTP</a>
                </div>
            </div>
        </div>
        <div class="popup-footer">
            <button class="btnf btn-cancel" id="cancelReset" onclick="closepopup()">Cancel</button>
            <button class="btnf btn-send" id="sendOtp" onclick="sendotp()">Send OTP</button>
            <button class="btnf btn-send" id="verifyOtp" onclick="submitotp()" style="display: none;">Submit
                OTP</button>
        </div>
    </div>
</div>
<!-- give new pass word window -->
<div class="newpass-popup" id="newpassword-popup">
    <div class="popup-content">
        <span class="close-btnf" id="closePopupf">&times;</span>
        <h2 id="givemsg">Set New Password</h2>
        <form id="newpassForm">
            <div class="form-groupf">
                <label for="newPassword">New Password</label>
                <div class="wrinput">
                    <input type="password" id="newPassword" placeholder="Enter new password" required>
                    <button type="button" id="toggleNewPassword" class="toggle-password-btn">
                        <img src="assits/openey.svg" alt="Toggle password" id="eyeicon-new">
                    </button>
                </div>
            </div>
            <div class="form-group">
                <label for="confirmPassword">Confirm Password</label>
                <div class="wrinput">
                    <input type="password" id="confirmPassword" placeholder="Confirm new password" required>
                    <button type="button" id="toggleConfirmPassword" class="toggle-password-btn">
                        <img src="assits/openey.svg" alt="Toggle password" id="eyeicon-confirm">
                    </button>
                </div>
            </div>
            <button type="button" class="submit-btnf" id="uppass" onclick="updatepass()">Update Password</button>
        </form>
    </div>
</div>
<script src="javascriptfiles/login.js"></script>
</body>
</html>