<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IoT Home Automation</title>
    <link rel="stylesheet" href="cssfiles/mainpage.css">
</head>

<body>
    <div class="app">

        <!-- ── Header ── -->
        <header class="header">
            <div class="logo">
                <div class="logo-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2">
                        <path d="M3 9.5L12 3l9 6.5V20a1 1 0 01-1 1H4a1 1 0 01-1-1V9.5z"/>
                        <path d="M9 21V12h6v9"/>
                    </svg>
                </div>
                <div>
                    <div class="logo-text">Home Automation</div>
                    <div class="logo-sub">IoT Control Panel</div>
                    <div class="logo-sub" id="user-name">Welcome</div>
                </div>
            </div>
            <nav class="navbar">
                <button class="nav-btn" id="wifiSettingsBtn">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12.55a11 11 0 0114.08 0M1.42 9a16 16 0 0121.16 0M8.53 16.11a6 6 0 016.95 0M12 20h.01"/></svg>
                    WiFi Settings
                </button>
                <button class="nav-btn" id="adminbtn" style="display:none;">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                    Admin
                </button>
                <button class="nav-btn" id="deviceNamesBtn">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                    Device Names
                </button>
                <button class="nav-btn" id="about_us">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
                    About
                </button>
                <button class="nav-btn danger" id="logout">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9"/></svg>
                    Logout
                </button>
            </nav>
        </header>

        <!-- ── Status Bar ── -->
        <div class="status-bar">
            <div class="status-dot" id="espStatusDot" style="background: #ff4757;"></div>
            <span class="status-text" id="espStatusText">ESP offline</span>
            <span class="status-sep">·</span>
            <span class="devices-on-count" id="devicesOnCount">0 devices active</span>
            <span class="status-sep">·</span>
            <span class="status-text" id="statusBarTimer" style="display:none;">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:inline;vertical-align:middle;margin-right:3px;"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                <span class="timer-status-text"></span>
            </span>
            <span class="status-sep" id="statusTimerSep" style="display:none;">·</span>
            <span class="status-text">Last sync: just now</span>
        </div>

        <!-- ── Device Grid ── -->
        <main class="main">
            <div class="section-label">Device Controls</div>
            <div class="mainbox">

                <!-- Room 1 Light -->
                <div class="card" id="card1" data-button-name="btn1">
                    <div class="card-glow"></div>
                    <div class="card-top">
                        <div class="device-icon">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18h6M10 22h4M12 2a7 7 0 017 7c0 2.5-1.3 4.7-3.3 6H8.3A7 7 0 0112 2z"/></svg>
                        </div>
                        <div class="toggle-wrap">
                            <div class="toggle-knob"></div>
                        </div>
                        <button class="timer-btn" id="timerBtn1" onclick="openTimerPopup('btn1', 1)" title="Set Timer">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                        </button>
                    </div>
                    <div class="card-name">Room 1 Light</div>
                    <div class="card-room">Bedroom</div>
                    <div class="card-status">Off</div>
                    <div class="timer-countdown" id="timerCountdown1"></div>
                    <button class="stylish-btn" id="buttonid1">off</button>
                </div>

                <!-- Room 2 Light -->
                <div class="card" id="card2" data-button-name="btn2">
                    <div class="card-glow"></div>
                    <div class="card-top">
                        <div class="device-icon">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18h6M10 22h4M12 2a7 7 0 017 7c0 2.5-1.3 4.7-3.3 6H8.3A7 7 0 0112 2z"/></svg>
                        </div>
                        <div class="toggle-wrap">
                            <div class="toggle-knob"></div>
                        </div>
                        <button class="timer-btn" id="timerBtn2" onclick="openTimerPopup('btn2', 2)" title="Set Timer">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                        </button>
                    </div>
                    <div class="card-name">Room 2 Light</div>
                    <div class="card-room">Bedroom 2</div>
                    <div class="card-status">Off</div>
                    <div class="timer-countdown" id="timerCountdown2"></div>
                    <button class="stylish-btn" id="buttonid2">off</button>
                </div>

                <!-- Dining Light -->
                <div class="card" id="card3" data-button-name="btn3">
                    <div class="card-glow"></div>
                    <div class="card-top">
                        <div class="device-icon">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18h6M10 22h4M12 2a7 7 0 017 7c0 2.5-1.3 4.7-3.3 6H8.3A7 7 0 0112 2z"/></svg>
                        </div>
                        <div class="toggle-wrap">
                            <div class="toggle-knob"></div>
                        </div>
                        <button class="timer-btn" id="timerBtn3" onclick="openTimerPopup('btn3', 3)" title="Set Timer">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                        </button>
                    </div>
                    <div class="card-name">Dining Light</div>
                    <div class="card-room">Dining Room</div>
                    <div class="card-status">Off</div>
                    <div class="timer-countdown" id="timerCountdown3"></div>
                    <button class="stylish-btn" id="buttonid3">off</button>
                </div>

                <!-- Dining Fan -->
                <div class="card" id="card4" data-button-name="btn4">
                    <div class="card-glow"></div>
                    <div class="card-top">
                        <div class="device-icon">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 12m-1 0a1 1 0 102 0 1 1 0 10-2 0"/><path d="M12 3c3 0 5 2 4 5s-4 3-4 3"/><path d="M21 12c0 3-2 5-5 4s-3-4-3-4"/><path d="M12 21c-3 0-5-2-4-5s4-3 4-3"/><path d="M3 12c0-3 2-5 5-4s3 4 3 4"/></svg>
                        </div>
                        <div class="toggle-wrap">
                            <div class="toggle-knob"></div>
                        </div>
                        <button class="timer-btn" id="timerBtn4" onclick="openTimerPopup('btn4', 4)" title="Set Timer">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                        </button>
                    </div>
                    <div class="card-name">Dining Fan</div>
                    <div class="card-room">Dining Room</div>
                    <div class="card-status">Off</div>
                    <div class="timer-countdown" id="timerCountdown4"></div>
                    <button class="stylish-btn" id="buttonid4">off</button>
                </div>

            </div>
        </main>

        <!-- ── Admin Popup ── -->
        <div id="popup" class="pop">
            <div class="modal-box" style="max-width:580px;">
                <div class="modal-header">
                    <div class="modal-title">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>
                        Admin Panel
                        <span class="user-count" id="userCount">0</span>
                    </div>
                    <div class="modal-actions">
                        <button class="modal-btn accent" onclick="refreshAdminUsers()" title="Refresh">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 4v6h-6M1 20v-6h6"/><path d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15"/></svg>
                        </button>
                        <button class="modal-btn" onclick="closePopup()">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 18L18 6M6 6l12 12"/></svg>
                            Close
                        </button>
                    </div>
                </div>
                <!-- Stats Row -->
                <div class="admin-stats" id="adminStats">
                    <div class="stat-card">
                        <div class="stat-number" id="statTotal">0</div>
                        <div class="stat-label">Total Users</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-number" id="statActive">0</div>
                        <div class="stat-label">Active</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-number" id="statBlocked">0</div>
                        <div class="stat-label">Blocked</div>
                    </div>
                </div>
                <div class="modal-body">
                    <div class="user-list-label">All Users</div>
                    <div class="admin-user-list" id="adminUserList">
                        <div class="admin-user-table-header">
                            <div class="col-name">Name</div>
                            <div class="col-email">Email</div>
                            <div class="col-type">Type</div>
                            <div class="col-status">Status</div>
                            <div class="col-actions">Actions</div>
                        </div>
                        <div id="adminUserRows"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ── WiFi Settings Popup (User) ── -->
        <div class="wifipass" id="wifiSettingsPopup">
            <div class="wifi-box">
                <div class="wifi-header">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#00d4aa" stroke-width="2"><path d="M5 12.55a11 11 0 0114.08 0M1.42 9a16 16 0 0121.16 0M8.53 16.11a6 6 0 016.95 0M12 20h.01"/></svg>
                    <span>WiFi Settings</span>
                </div>
                <div class="wifi-body">
                    <!-- Saved Networks List -->
                    <div class="wifi-label">Saved Networks</div>
                    <div class="wifi-saved-list" id="wifiSavedList">
                        <div class="wifi-saved-loading">Loading saved networks...</div>
                    </div>
                    <div class="wifi-divider">
                        <span>or enter manually</span>
                    </div>
                    <!-- Manual Entry -->
                    <label class="wifi-label" for="wifiSsid">Network Name (SSID)</label>
                    <input type="text" id="wifiSsid" class="wifi-input" placeholder="Enter WiFi network name">
                    <label class="wifi-label" for="wifiPassword">Password</label>
                    <div class="wifi-password-wrap">
                        <input type="password" id="wifiPassword" class="wifi-input" placeholder="Enter WiFi password">
                        <button type="button" class="wifi-eye-btn" id="toggleWifiPassword" onclick="toggleWifiPasswordVisibility()">
                            <svg id="wifiEyeIcon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                        </button>
                    </div>
                    <div class="wifi-actions">
                        <button class="wifi-btn primary" id="saveWifiSettings">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 2L11 13M22 2L15 22l-4-9-9-4 20-7z"/></svg>
                            Save WiFi
                        </button>
                        <button class="wifi-btn cancel" type="button" onclick="closeWifiSettingsPopup()">Cancel</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- ── Admin Change WiFi Popup ── -->
        <div class="wifipass" id="wifipass">
            <div class="wifi-box">
                <div class="wifi-header">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#00d4aa" stroke-width="2"><path d="M5 12.55a11 11 0 0114.08 0M1.42 9a16 16 0 0121.16 0M8.53 16.11a6 6 0 016.95 0M12 20h.01"/></svg>
                    <span id="wifipassheding">Change ESP WiFi Credentials</span>
                </div>
                <div class="wifi-body">
                    <label class="wifi-label" for="ssid">Network Name (SSID)</label>
                    <input type="text" id="ssid" class="wifi-input" placeholder="Enter new SSID" required>
                    <label class="wifi-label" for="ssidpasspassword">Password</label>
                    <input type="password" id="ssidpasspassword" class="wifi-input" placeholder="Enter new password" required>
                    <div class="wifi-actions">
                        <button class="wifi-btn primary" id="changewifi">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 2L11 13M22 2L15 22l-4-9-9-4 20-7z"/></svg>
                            Update WiFi
                        </button>
                        <button class="wifi-btn cancel" type="button" onclick="closeWifiPopup()">Cancel</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- ── Device Names Settings Popup ── -->
        <div class="wifipass" id="deviceNamesPopup">
            <div class="wifi-box" style="max-width:560px;">
                <div class="wifi-header">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#00d4aa" stroke-width="2"><path d="M12 20h9M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                    <span>Customize Device Names</span>
                </div>
                <div class="wifi-body">
                    <div class="device-names-grid">
                        <div class="device-card-edit" id="deviceCardEdit1">
                            <div class="device-card-icon">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18h6M10 22h4M12 2a7 7 0 017 7c0 2.5-1.3 4.7-3.3 6H8.3A7 7 0 0112 2z"/></svg>
                            </div>
                            <div class="device-card-label">Room 1 Light</div>
                            <input type="text" id="customName-btn1" class="device-input" placeholder="Device name">
                            <input type="text" id="customRoom-btn1" class="device-input" placeholder="Room name">
                        </div>
                        <div class="device-card-edit" id="deviceCardEdit2">
                            <div class="device-card-icon">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18h6M10 22h4M12 2a7 7 0 017 7c0 2.5-1.3 4.7-3.3 6H8.3A7 7 0 0112 2z"/></svg>
                            </div>
                            <div class="device-card-label">Room 2 Light</div>
                            <input type="text" id="customName-btn2" class="device-input" placeholder="Device name">
                            <input type="text" id="customRoom-btn2" class="device-input" placeholder="Room name">
                        </div>
                        <div class="device-card-edit" id="deviceCardEdit3">
                            <div class="device-card-icon">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18h6M10 22h4M12 2a7 7 0 017 7c0 2.5-1.3 4.7-3.3 6H8.3A7 7 0 0112 2z"/></svg>
                            </div>
                            <div class="device-card-label">Dining Light</div>
                            <input type="text" id="customName-btn3" class="device-input" placeholder="Device name">
                            <input type="text" id="customRoom-btn3" class="device-input" placeholder="Room name">
                        </div>
                        <div class="device-card-edit" id="deviceCardEdit4">
                            <div class="device-card-icon">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 12m-1 0a1 1 0 102 0 1 1 0 10-2 0"/><path d="M12 3c3 0 5 2 4 5s-4 3-4 3"/><path d="M21 12c0 3-2 5-5 4s-3-4-3-4"/><path d="M12 21c-3 0-5-2-4-5s4-3 4-3"/><path d="M3 12c0-3 2-5 5-4s3 4 3 4"/></svg>
                            </div>
                            <div class="device-card-label">Dining Fan</div>
                            <input type="text" id="customName-btn4" class="device-input" placeholder="Device name">
                            <input type="text" id="customRoom-btn4" class="device-input" placeholder="Room name">
                        </div>
                    </div>
                    <div class="wifi-actions">
                        <button class="wifi-btn primary" id="saveDeviceNames">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                            Save Names
                        </button>
                        <button class="wifi-btn cancel" type="button" onclick="closeDeviceNamesPopup()">Cancel</button>
                    </div>
                </div>
            </div>
        </div>

    </div><!-- end .app -->

    <!-- ── Timer Popup ── -->
    <div class="wifipass" id="timerPopup">
        <div class="wifi-box" style="max-width: 420px;">
            <div class="wifi-header">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#00d4aa" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                <span id="timerPopupTitle">Set Timer</span>
            </div>
            <div class="wifi-body">
                <!-- Target Device -->
                <div class="timer-target" id="timerTarget">
                    <div class="timer-target-icon">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18h6M10 22h4M12 2a7 7 0 017 7c0 2.5-1.3 4.7-3.3 6H8.3A7 7 0 0112 2z"/></svg>
                    </div>
                    <div>
                        <div class="timer-target-name" id="timerTargetName">Room 1 Light</div>
                        <div class="timer-target-room" id="timerTargetRoom">Bedroom</div>
                    </div>
                </div>

                <!-- Duration Presets -->
                <div class="timer-presets" id="timerPresets">
                    <div class="wifi-label">Duration</div>
                    <div class="timer-preset-btns">
                        <button class="timer-preset" data-minutes="5" onclick="setTimerDuration(5)">5m</button>
                        <button class="timer-preset" data-minutes="15" onclick="setTimerDuration(15)">15m</button>
                        <button class="timer-preset" data-minutes="30" onclick="setTimerDuration(30)">30m</button>
                        <button class="timer-preset" data-minutes="60" onclick="setTimerDuration(60)">1h</button>
                    </div>
                </div>

                <!-- Custom Duration -->
                <div class="timer-custom-row" id="timerCustomRow">
                    <div class="timer-custom-input-wrap">
                        <input type="number" id="timerCustomMinutes" class="wifi-input" placeholder="Custom" min="1" max="1440">
                        <span class="timer-custom-label">min</span>
                    </div>
                    <div class="timer-action-btns">
                        <button class="timer-action-btn" id="timerActionOn" onclick="setTimerAction('ON')">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18h6M10 22h4M12 2a7 7 0 017 7c0 2.5-1.3 4.7-3.3 6H8.3A7 7 0 0112 2z"/></svg>
                            Turn ON
                        </button>
                        <button class="timer-action-btn off" id="timerActionOff" onclick="setTimerAction('OFF')">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
                            Turn OFF
                        </button>
                    </div>
                </div>

                <!-- Selected Summary -->
                <div class="timer-summary" id="timerSummary">
                    <span id="timerSummaryText">Select a duration</span>
                </div>

                <!-- Active Timer Info (shown when timer exists) -->
                <div class="timer-active-info" id="timerActiveInfo" style="display:none;">
                    <div class="timer-active-countdown" id="timerActiveCountdown"></div>
                    <div class="timer-active-sub" id="timerActiveSub"></div>
                </div>

                <div class="wifi-actions">
                    <button class="wifi-btn danger" id="cancelTimerBtn" style="display:none;" onclick="cancelCurrentTimer()">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                        Cancel Timer
                    </button>
                    <button class="wifi-btn primary" id="startTimerBtn" onclick="startTimer()">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                        Start Timer
                    </button>
                    <button class="wifi-btn cancel" type="button" onclick="closeTimerPopup()">Close</button>
                </div>
            </div>
        </div>
    </div>

    <!-- ── Custom Alert Modal ── -->
    <div class="custom-alert-overlay" id="customAlertOverlay">
        <div class="custom-alert-box">
            <div class="custom-alert-icon" id="customAlertIcon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
            </div>
            <div class="custom-alert-title" id="customAlertTitle">Alert</div>
            <div class="custom-alert-message" id="customAlertMessage"></div>
            <div class="custom-alert-actions">
                <button class="custom-alert-btn" id="customAlertOk">OK</button>
                <button class="custom-alert-btn cancel" id="customAlertCancel" style="display:none;">Cancel</button>
            </div>
        </div>

    <!-- ── Custom Alert Modal ── -->
    <div class="custom-alert-overlay" id="customAlertOverlay">
        <div class="custom-alert-box">
            <div class="custom-alert-icon" id="customAlertIcon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
            </div>
